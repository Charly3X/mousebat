# Grants access to Logitech HID++ devices to the user of the active local session.
# ATTRS{} also matches parent devices, which is why the receiver's USB vendor id
# is visible from the hidraw node.
#
# Both add and change are matched: without change the rule would not apply to
# already-connected devices on `udevadm trigger`, and access would only appear
# after physically replugging the receiver.
#
# Install:
#   sudo cp packaging/42-battary-hidraw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --action=add --subsystem-match=hidraw

ACTION=="add|change", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
