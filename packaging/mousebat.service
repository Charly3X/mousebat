[Unit]
Description=Wireless mouse battery tray indicator
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m mousebat
WorkingDirectory=%h/projects/mousebat
Environment=PYTHONPATH=%h/projects/mousebat
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
